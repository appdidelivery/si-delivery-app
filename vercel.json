{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "csi.velodelivery.com.br"
        }
      ],
      "destination": "https://www.convenienciasantaisabel.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cowburguer.velodelivery.com.br"
        }
      ],
      "destination": "https://www.velodelivery.com.br",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "encantolilas.velodelivery.com.br"
        }
      ],
      "destination": "https://www.encantolilas.app.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ng.velodelivery.com.br"
        }
      ],
      "destination": "https://www.ngconveniencia.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "macanudorex.velodelivery.com.br"
        }
      ],
      "destination": "https://www.macanudorex.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "coelhoscuca.velodelivery.com.br"
        }
      ],
      "destination": "https://www.coelhoscuca.com.br/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron-automations",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/sync-google-reviews",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/whatsapp-retention-wed",
      "schedule": "0 20 * * 3"
    },
    {
      "path": "/api/whatsapp-retention-fri",
      "schedule": "30 20 * * 5"
    },
    {
      "path": "/api/whatsapp-retention-sat",
      "schedule": "0 14 * * 6"
    },
    {
      "path": "/api/whatsapp-retention-sun",
      "schedule": "0 14 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/manifest"
    },
    {
      "source": "/api/velopay/(.*)",
      "destination": "/api/velopay/$1"
    },
    {
      "source": "/api/social",
      "destination": "/api/social"
    },
    {
      "source": "/api/journey-schedule",
      "destination": "/api/index"
    },
    {
      "source": "/api/app-version",
      "destination": "/api/index"
    },
    {
      "source": "/api/change-team-password",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|TelegramBot|viber).*"
        }
      ],
      "destination": "/api/social?route=/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/queue-journey.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "velo-whatsapp-journey",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/whatsapp-retention-wed.js": {
      "maxDuration": 60
    },
    "api/whatsapp-retention-fri.js": {
      "maxDuration": 60
    },
    "api/whatsapp-retention-sat.js": {
      "maxDuration": 60
    },
    "api/whatsapp-retention-sun.js": {
      "maxDuration": 60
    }
  }
}
